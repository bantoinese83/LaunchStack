# =============================================================================
# Mystic Hair Co. — copy to apps/web/.env.local and apps/mobile/.env
# See docs/client/LAUNCH.md
# =============================================================================

# Optional — 21st.dev MCP in Cursor (~/.cursor/mcp.json). Set in shell, not Next.js:
# TWENTY_FIRST_DEV_API_KEY=

# SUPABASE (linked project: ipwubzqckiubrvrouzye)
NEXT_PUBLIC_SUPABASE_URL=https://ipwubzqckiubrvrouzye.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

EXPO_PUBLIC_SUPABASE_URL=https://ipwubzqckiubrvrouzye.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# App URLs (mobile must reach web API)
NEXT_PUBLIC_APP_URL=http://localhost:3000
EXPO_PUBLIC_APP_URL=http://localhost:3000
# Google OAuth: configure Google Cloud + Supabase (see docs/client/GOOGLE-OAUTH.md).
# Run: node scripts/print-google-oauth-uris.mjs
# Local supabase CLI only (optional): GOOGLE_OAUTH_CLIENT_ID= GOOGLE_OAUTH_CLIENT_SECRET=
# Supabase redirect URLs: {NEXT_PUBLIC_APP_URL}/auth/callback and mystichair://auth/callback

# Mystic workspace (seed default — override only if you create a new workspace)
NEXT_PUBLIC_MYSTIC_WORKSPACE_ID=33333333-3333-3333-3333-333333333333
EXPO_PUBLIC_MYSTIC_WORKSPACE_ID=33333333-3333-3333-3333-333333333333

# STRIPE (required for paid checkout in production)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MYSTIC_GLOW=
STRIPE_PRICE_MYSTIC_LUXE=
STRIPE_PRICE_MYSTIC_PACK_4=
STRIPE_PRICE_MYSTIC_PACK_6=
STRIPE_PRICE_MYSTIC_PACK_10=

# BREVO (optional — booking confirmation email)
BREVO_API_KEY=
SENDER_EMAIL=
SENDER_NAME=Mystic Hair Co.

# TWILIO (optional — on-the-way / door timer SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_FROM=

# Cron — door timer auto no-show (Vercel Cron sends Authorization: Bearer …)
CRON_SECRET=

# Maps — OpenStreetMap until Google billing is on (see docs/client/GOOGLE-MAPS.md)
# osm | google | auto (try Google, fall back to OSM if JS API fails)
NEXT_PUBLIC_MYSTIC_MAPS_PROVIDER=osm

# Google Maps Platform (optional until billing enabled)
# Browser: Maps JavaScript API (referrer-restricted)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional custom Map ID from Cloud Console → Map Management
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Server: Geocoding + Places (IP-restricted; fallback: Nominatim)
GOOGLE_MAPS_GEOCODING_KEY=
GOOGLE_MAPS_SERVER_KEY=

# Analytics / monitoring (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
SENTRY_DSN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Mobile maps (optional — Android Google Maps; iOS uses Apple Maps without a key)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# EAS / CI (optional — mobile store builds)
# EXPO_TOKEN=

# Pixabay (optional — run: pnpm fetch:pixabay)
# PIXABAY_API_KEY=  # pnpm fetch:pixabay (hero, stylist, auth poster/video, service icons)
