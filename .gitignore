# Node dependencies
node_modules/
.pnpm-store/
.cache/

# Next.js build
.next/
out/
build/
dist/

# Turborepo cache — do not commit cache blobs
.turbo/

# TypeScript incremental build info
*.tsbuildinfo

# Compiled package output — source is the source of truth
packages/*/dist/
apps/*/dist/

# Storybook
storybook-static/

# Expo / React Native build
.expo/
# Local prebuild (EAS generates native projects in CI); keeps Pods/build out of git
apps/mobile/ios/
*.apk
*.aab
*.ipa

# Google OAuth client downloads (never commit)
client_secret*.json

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Supabase
.branches/
supabase/.temp/

# Client discovery assets (keep locally; too large for git)
docs/client/.whisper-cache/
docs/client/*.wav
docs/client/*.m4a
docs/client/*.pt

# Playwright
apps/web/test-results/
apps/web/playwright-report/

# IDE & OS
.DS_Store
*.pem
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea
.vercel
.env*.local
