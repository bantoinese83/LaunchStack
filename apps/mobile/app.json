{
  "expo": {
    "name": "Mystic Hair Co",
    "slug": "mystic-hair-co",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mystichair",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.mystichair.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F4ED"
      },
      "package": "co.mystichair.app"
    },
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/03a387d4-94e2-49b3-8448-2bcbda7109b8"
    },
    "extra": {
      "appUrl": "https://mystic-hair-co.vercel.app",
      "googleMapsApiKey": "",
      "router": {},
      "eas": {
        "projectId": "03a387d4-94e2-49b3-8448-2bcbda7109b8"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-notifications",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "image": "./assets/mystic-hair-logo-light.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F7F4ED",
          "dark": {
            "backgroundColor": "#F7F4ED"
          }
        }
      ],
      "expo-web-browser"
    ],
    "owner": "mlabs83"
  }
}
