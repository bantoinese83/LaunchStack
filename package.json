{
  "name": "mystic-hair-co",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@template/web",
    "google-oauth:uris": "node scripts/print-google-oauth-uris.mjs",
    "fetch:pixabay": "node scripts/fetch-pixabay-all.mjs",
    "fetch:marketing-images": "node scripts/fetch-pixabay-all.mjs",
    "fetch:auth-video": "node scripts/fetch-pixabay-all.mjs",
    "process:logo": "node scripts/process-mystic-logo.mjs",
    "dev:mobile": "turbo run dev --filter=@template/mobile",
    "dev:admin": "turbo run dev --filter=@template/admin",
    "build:web": "turbo run build --filter=@template/web",
    "build:mobile": "turbo run build --filter=@template/mobile",
    "build:admin": "turbo run build --filter=@template/admin",
    "mobile": "pnpm --filter @template/mobile start",
    "mobile:clean": "pnpm --filter @template/mobile start:clean",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:expo": "pnpm --filter @template/mobile exec -- npx --yes expo-doctor@latest",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/types/src/supabase.ts",
    "db:types:remote": "supabase gen types typescript --linked 2>/dev/null > packages/types/src/supabase.ts",
    "db:push": "supabase db push --linked",
    "db:seed:remote": "supabase db query --linked --file supabase/seed.sql",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @template/web test:e2e",
    "verify:integrations": "node scripts/verify-integrations.mjs",
    "storybook": "pnpm --filter @template/ui storybook",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "turbo run clean && rimraf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.5",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.7",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@9.0.6",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css}": [
      "prettier --write"
    ]
  }
}
