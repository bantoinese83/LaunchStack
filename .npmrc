# Workspace libraries (e.g. @template/mobile-ui) declare React / React Native
# as peerDependencies and must NOT get their own copy installed. A second
# copy of a native module breaks Metro autolinking and the native build;
# `expo-doctor` flags it as "duplicate native modules". The consuming app
# (apps/mobile) owns those versions.
#
# Note: pnpm 9 reads this from .npmrc, not pnpm-workspace.yaml.
auto-install-peers=false
